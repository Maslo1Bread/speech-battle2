# Секрет для JWT и Fernet (смените в проде)
SECRET_KEY=your_key

# Опционально: бесплатный ключ Groq https://console.groq.com
# Без ключа используется локальный сценарийный ИИ-ответчик
GROQ_API_KEY=your_key

# Админ по умолчанию (создаётся при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@speech-battle.local
